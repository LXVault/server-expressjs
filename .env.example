# ---------------------------------------------------------------------------
# Example environment configuration.
# Copy this file to `.env` and adjust the values for your setup.
#
# Every variable below also has a hard-coded fallback in the application code,
# so in development the app still boots if a value is missing. That fallback is
# DEVELOPMENT ONLY. With NODE_ENV=production the server refuses to start unless
# JWT_SECRET, ENCRYPTION_KEY and DATABASE_URL are all set to real values, and
# refuses again if any of them still holds the value published here.
# ---------------------------------------------------------------------------

# --- Backend (server-expressjs) ---
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (pgvector enabled).
# NOTE: this localhost value is for running the backend directly on your host
# (e.g. `npm run dev`). In production it must be your real connection string —
# the server refuses to start while it still holds the value below, because
# the role name and password in it are published in this repository.
DATABASE_URL=postgresql://mcp_user:mcp_password@localhost:5432/mcp_rag

# Individual DB parts (used by docker-compose / fallback config)
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=mcp_password
POSTGRES_DB=mcp_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Auth
# Generate a real value: openssl rand -hex 32
# Anyone holding this value can mint a valid session for any account, so it is
# never committed and never left at a published default.
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Encryption key used to encrypt users' OpenRouter API keys at rest (AES-256-GCM).
# Generate a different real value: openssl rand -hex 32
# Any string works — it is hashed once with SHA-256 to produce the 32-byte key.
# That single fast pass is not a key derivation function; a scrypt derivation is
# the planned replacement (see .agents/memory/tasks/security-hardening.md).
# Rotating this makes every previously stored key undecryptable, and there is no
# re-encryption path, so rotate deliberately and not after users have onboarded.
ENCRYPTION_KEY=

# OpenRouter (OpenAI-compatible) embeddings base URL. Each user supplies their
# OWN OpenRouter API key via the web app; the server never ships a global key.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# CORS
CORS_ORIGIN=http://localhost:5173

# Number of proxies in front of this process, so `req.ip` is the client rather
# than the proxy. Leave it unset when the app is reached directly: without it,
# every request appears to come from the connecting peer, which is safe.
# Set it to 1 when exactly one proxy you control (Render, nginx) forwards the
# request and overwrites X-Forwarded-For on the way in.
# Do NOT set it to `true`. That trusts the whole chain, which means trusting
# whatever the last hop wrote — and the last hop is the client.
# Getting this wrong is the difference between a rate limit that works and one
# that anyone can walk through with a forged header.
# TRUST_PROXY=1

# --- Frontend (client-reactjs) ---
# Base URL the React app uses to reach the backend API. Leave as the relative
# `/api` so nginx (prod) / the Vite dev server proxy the call to the backend;
# only set an absolute URL if the API is hosted on a separate origin.
VITE_API_URL=/api

# Host port the frontend container is published on.
FRONTEND_PORT=5173
